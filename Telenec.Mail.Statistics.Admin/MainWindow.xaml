<Window x:Class="Telenec.Mail.Statistics.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/TelenecMailAdmin.ico"
        Width="1180"
        Height="820"
        MinWidth="1000"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>

        <!-- Gemeinsame Farben -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#0069B4" />

        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#FFFFFF" />

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#1E293B" />

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B" />

        <SolidColorBrush x:Key="TodayBrush"
                         Color="#0069B4" />

        <SolidColorBrush x:Key="WeekBrush"
                         Color="#3B82F6" />

        <SolidColorBrush x:Key="MonthBrush"
                         Color="#94A3B8" />

        <SolidColorBrush x:Key="InactiveBrush"
                         Color="#F59E0B" />

        <!-- Statistik-Karten -->

        <Style x:Key="DashboardCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}" />

            <Setter Property="CornerRadius"
                    Value="12" />

            <Setter Property="Padding"
                    Value="22" />

            <Setter Property="Margin"
                    Value="6" />

            <Setter Property="BorderBrush"
                    Value="#E2E8F0" />

            <Setter Property="BorderThickness"
                    Value="1" />

        </Style>

        <Style x:Key="MetricValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="34" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="HorizontalAlignment"
                    Value="Center" />

        </Style>

        <Style x:Key="MetricLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />

            <Setter Property="HorizontalAlignment"
                    Value="Center" />

            <Setter Property="TextAlignment"
                    Value="Center" />

            <Setter Property="TextWrapping"
                    Value="Wrap" />

            <Setter Property="Margin"
                    Value="0,8,0,0" />

        </Style>

        <!-- Statistik-Diagramme -->

        <Style x:Key="ChartProgressBar"
               TargetType="ProgressBar">

            <Setter Property="Height"
                    Value="14" />

            <Setter Property="Minimum"
                    Value="0" />

            <Setter Property="Maximum"
                    Value="100" />

            <Setter Property="Background"
                    Value="#E8EDF2" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <Style x:Key="ChartLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <Style x:Key="ChartValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />

            <Setter Property="HorizontalAlignment"
                    Value="Right" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <!-- Statistik-Status -->

        <Style x:Key="StatusBorderStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#EFF6FF" />

            <Setter Property="BorderBrush"
                    Value="#BFDBFE" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">

                    <Setter Property="Background"
                            Value="#F0FDF4" />

                    <Setter Property="BorderBrush"
                            Value="#BBF7D0" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">

                    <Setter Property="Background"
                            Value="#FFF7ED" />

                    <Setter Property="BorderBrush"
                            Value="#FED7AA" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">

                    <Setter Property="Background"
                            Value="#FEF2F2" />

                    <Setter Property="BorderBrush"
                            Value="#FECACA" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="StatusTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="#1D4ED8" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">

                    <Setter Property="Foreground"
                            Value="#166534" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">

                    <Setter Property="Foreground"
                            Value="#9A3412" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">

                    <Setter Property="Foreground"
                            Value="#991B1B" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- Reputations-Karten -->

        <Style x:Key="ReputationCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="Padding"
                    Value="15" />

            <Setter Property="BorderBrush"
                    Value="#E2E8F0" />

            <Setter Property="BorderThickness"
                    Value="1" />

        </Style>

        <Style x:Key="ReputationFieldLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />

            <Setter Property="Margin"
                    Value="0,0,0,5" />

        </Style>

        <Style x:Key="ReputationFieldValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="16" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="TextWrapping"
                    Value="Wrap" />

        </Style>

        <!-- Kompakte Blacklist-Statussymbole -->

        <Style x:Key="BlacklistStatusSymbol"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="19" />

            <Setter Property="FontWeight"
                    Value="Bold" />

            <Setter Property="Foreground"
                    Value="#64748B" />

            <Setter Property="Width"
                    Value="26" />

            <Setter Property="TextAlignment"
                    Value="Center" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">

                    <Setter Property="Foreground"
                            Value="#16A34A" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">

                    <Setter Property="Foreground"
                            Value="#DC2626" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">

                    <Setter Property="Foreground"
                            Value="#D97706" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Neutral">

                    <Setter Property="Foreground"
                            Value="#94A3B8" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="BlacklistStatusLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="Foreground"
                    Value="#64748B" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">

                    <Setter Property="Foreground"
                            Value="#166534" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">

                    <Setter Property="Foreground"
                            Value="#991B1B" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">

                    <Setter Property="Foreground"
                            Value="#9A3412" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <!-- Fensteraufbau -->

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="pack://application:,,,/Assets/TelenecMailAdminPanelLogo.png"
                   Height="82"
                   MaxWidth="470"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Stretch="Uniform" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="Aktualisieren"
                        Command="{Binding RefreshCommand}"
                        Padding="16,8"
                        Margin="0,0,12,0"
                        FontSize="14"
                        Cursor="Hand" />

                <Border Background="{StaticResource PrimaryBrush}"
                        CornerRadius="8"
                        Padding="14,8">

                    <TextBlock Text="{Binding ApplicationVersionText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="15" />

                </Border>

            </StackPanel>

        </Grid>

        <!-- Registerkarten -->

        <TabControl Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="#E2E8F0"
                    FontSize="14">

            <!-- Nutzungsstatistik -->

            <TabItem Header="Nutzungsstatistik"
                     Padding="18,9">

                <Grid Margin="12,16,12,12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Kennzahlen -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource DashboardCard}">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding TotalInstallations}"
                                           FontSize="44"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" />

                                <TextBlock Text="Installationen insgesamt"
                                           Style="{StaticResource MetricLabel}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource DashboardCard}">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding ActiveToday}"
                                           Style="{StaticResource MetricValue}" />

                                <TextBlock Text="Heute aktiv"
                                           Style="{StaticResource MetricLabel}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource DashboardCard}">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding ActiveLast7Days}"
                                           Style="{StaticResource MetricValue}" />

                                <TextBlock Text="Letzte 7 Tage"
                                           Style="{StaticResource MetricLabel}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="3"
                                Style="{StaticResource DashboardCard}">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding ActiveLast30Days}"
                                           Style="{StaticResource MetricValue}" />

                                <TextBlock Text="Letzte 30 Tage"
                                           Style="{StaticResource MetricLabel}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource DashboardCard}">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding InactiveOver30Days}"
                                           Style="{StaticResource MetricValue}" />

                                <TextBlock Text="Über 30 Tage inaktiv"
                                           Style="{StaticResource MetricLabel}" />

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- Beide bestehenden Statistikdiagramme -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Diagramm: Aktivität nach Zeitraum -->

                        <Border Grid.Column="0"
                                Style="{StaticResource DashboardCard}"
                                Margin="0">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Aktivität nach Zeitraum"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />

                                <TextBlock Grid.Row="2"
                                           Text="Kumulative Reichweite bezogen auf alle Installationen"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                <Grid Grid.Row="4">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Heute"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveTodayPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource TodayBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveTodayChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Letzte 7 Tage"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveLast7DaysPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource WeekBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveLast7DaysChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Letzte 30 Tage"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveLast30DaysPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource MonthBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveLast30DaysChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="3"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Über 30 Tage"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding InactiveOver30DaysPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource InactiveBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding InactiveOver30DaysChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                        <!-- Diagramm: Verteilung nach letztem Kontakt -->

                        <Border Grid.Column="2"
                                Style="{StaticResource DashboardCard}"
                                Margin="0">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Verteilung nach letztem Kontakt"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />

                                <TextBlock Grid.Row="2"
                                           Text="Jede Installation erscheint genau in einer Gruppe"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                <Grid Grid.Row="4">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Heute"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveTodayPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource TodayBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveTodayChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Vor 1–7 Tagen"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveDays1To7Percentage, Mode=OneWay}"
                                                     Foreground="{StaticResource WeekBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveDays1To7ChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Vor 8–30 Tagen"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveDays8To30Percentage, Mode=OneWay}"
                                                     Foreground="{StaticResource MonthBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveDays8To30ChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="3"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Über 30 Tage"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding InactiveOver30DaysPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource InactiveBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding InactiveOver30DaysChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                    </Grid>

                    <!-- Statistik-Statuszeile -->

                    <Border Grid.Row="4"
                            Style="{StaticResource StatusBorderStyle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8">

                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource StatusTextStyle}" />

                    </Border>

                </Grid>

            </TabItem>

            <!-- Mailserver-Reputation -->

            <TabItem Header="Mailserver-Reputation"
                     Padding="18,9">

                <Grid Margin="18,18,18,16">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Überschrift, manueller Start und Prüfumfang -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="{Binding ReputationTitle}"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />

                            <TextBlock Text="Übersicht der überwachten Blacklist-Anbieter"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,4,0,0" />

                        </StackPanel>

                        <!-- Manueller Blacklist-Check.
                             Der AsyncRelayCommand verhindert
                             während der Ausführung weitere Klicks. -->

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button Command="{Binding CheckReputationCommand}"
                                    Padding="16,9"
                                    Margin="0,0,12,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Background="#0069B4"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand">

                                <Button.Style>

                                    <Style TargetType="Button">

                                        <Setter Property="Content"
                                                Value="Jetzt prüfen" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsReputationChecking}"
                                                         Value="True">

                                                <Setter Property="Content"
                                                        Value="Prüfung läuft …" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Button.Style>

                            </Button>

                            <Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    VerticalAlignment="Center">

                                <TextBlock Text="{Binding ReputationScopeText}"
                                           FontSize="12"
                                           Foreground="#1D4ED8"
                                           FontWeight="SemiBold" />

                            </Border>

                        </StackPanel>

                    </Grid>

                    <!-- Mailserver-Informationen -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource ReputationCard}">

                            <StackPanel>

                                <TextBlock Text="Mailserver"
                                           Style="{StaticResource ReputationFieldLabel}" />

                                <TextBlock Text="{Binding ReputationHostname}"
                                           Style="{StaticResource ReputationFieldValue}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource ReputationCard}">

                            <StackPanel>

                                <TextBlock Text="Versand-IP"
                                           Style="{StaticResource ReputationFieldLabel}" />

                                <TextBlock Text="{Binding ReputationIpAddress}"
                                           Style="{StaticResource ReputationFieldValue}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource ReputationCard}">

                            <StackPanel>

                                <TextBlock Text="Letzte erfolgreiche PSBL-Prüfung"
                                           Style="{StaticResource ReputationFieldLabel}" />

                                <TextBlock Text="{Binding ReputationLastSuccessfulCheckText}"
                                           Style="{StaticResource ReputationFieldValue}" />

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- Zusammenfassung -->

                    <Border Grid.Row="4"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">

                        <StackPanel>

                            <TextBlock Text="{Binding ReputationSummaryText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding ReputationStatusText}"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding ReputationDetailText}"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       MaxHeight="32" />

                            <!-- Rückmeldung zum manuellen Prüfvorgang -->

                            <TextBlock Text="{Binding ReputationCheckMessage}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#1D4ED8"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                    <!-- Dynamische Blacklist-Liste -->

                    <DataGrid Grid.Row="6"
                              ItemsSource="{Binding ReputationEntries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              VerticalGridLinesBrush="Transparent"
                              RowHeight="34"
                              ColumnHeaderHeight="34"
                              Background="White"
                              BorderBrush="#E2E8F0"
                              BorderThickness="1"
                              FontSize="13"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="White"
                              EnableRowVirtualization="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <!-- Technische Details bei Mausberührung -->

                        <DataGrid.RowStyle>

                            <Style TargetType="{x:Type DataGridRow}">

                                <Setter Property="ToolTip"
                                        Value="{Binding DetailsText}" />

                                <Setter Property="MinHeight"
                                        Value="34" />

                            </Style>

                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <!-- Name der Blacklist -->

                            <DataGridTextColumn Header="BLACKLIST"
                                                Binding="{Binding DisplayName}"
                                                Width="*">

                                <DataGridTextColumn.ElementStyle>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="VerticalAlignment"
                                                Value="Center" />

                                        <Setter Property="Foreground"
                                                Value="#1E293B" />

                                        <Setter Property="FontWeight"
                                                Value="Medium" />

                                        <Setter Property="Margin"
                                                Value="12,0,0,0" />

                                        <Setter Property="TextTrimming"
                                                Value="CharacterEllipsis" />

                                    </Style>

                                </DataGridTextColumn.ElementStyle>

                            </DataGridTextColumn>

                            <!-- Statussymbol und Statusbezeichnung -->

                            <DataGridTemplateColumn Header="STATUS"
                                                    Width="195"
                                                    CanUserSort="False">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid Margin="8,0,12,0">

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding DetailsText}">

                                                <TextBlock Text="{Binding StatusSymbol}"
                                                           Style="{StaticResource BlacklistStatusSymbol}" />

                                                <TextBlock Text="{Binding StatusText}"
                                                           Style="{StaticResource BlacklistStatusLabel}"
                                                           Margin="6,0,0,0" />

                                            </StackPanel>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- Statuslegende und letzter Abruf -->

                    <Grid Grid.Row="8">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0">

                            <TextBlock Text="✔  Nicht gelistet"
                                       Foreground="#166534"
                                       FontSize="12"
                                       Margin="0,0,20,0" />

                            <TextBlock Text="✖  Gelistet"
                                       Foreground="#991B1B"
                                       FontSize="12"
                                       Margin="0,0,20,0" />

                            <TextBlock Text="⚠  Prüfung fehlgeschlagen"
                                       Foreground="#9A3412"
                                       FontSize="12"
                                       Margin="0,0,20,0" />

                            <TextBlock Text="—  Nicht integriert / ungeprüft"
                                       Foreground="#64748B"
                                       FontSize="12" />

                        </WrapPanel>

                        <StackPanel Grid.Row="2">

                            <TextBlock FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap">

                                <Run Text="Letzter Prüfversuch: " />

                                <Run Text="{Binding ReputationLastAttemptText}" />

                                <Run Text=" · DNS-Auflösung: " />

                                <Run Text="{Binding ReputationResolvedAddresses}" />

                            </TextBlock>

                            <TextBlock Text="Die angezeigten Ergebnisse gelten nur für tatsächlich geprüfte Listen. Nicht integrierte Anbieter sind keine negativen Prüfergebnisse."
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />

                        </StackPanel>

                    </Grid>

                </Grid>

            </TabItem>

            <!-- Mail-Statistik: serverseitig aggregierte Daten der letzten 24 Stunden.
                 Nicht verfügbare Daten werden NICHT als null E-Mails dargestellt. -->
            <TabItem Header="Mail-Statistik"
                     Padding="18,9">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="12,16,12,22">

                        <TextBlock Text="Mail-Statistik"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />

                        <TextBlock Text="Mailserver-Verkehr der letzten 24 Stunden · stündliche Aggregation"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,3,0,14" />

                        <Border CornerRadius="8"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                Background="#EFF6FF"
                                Padding="12,10"
                                Margin="0,0,0,14">

                            <TextBlock Text="{Binding MailTrafficStatusText}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="#1D4ED8" />
                        </Border>

                        <!-- Zeitfenster und Summen -->

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource ReputationCard}"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Auswertungszeitraum"
                                               Style="{StaticResource ReputationFieldLabel}" />
                                    <TextBlock Text="{Binding MailTrafficPeriodText}"
                                               Style="{StaticResource ReputationFieldValue}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource ReputationCard}"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Ausgehend · 24 Stunden"
                                               Style="{StaticResource ReputationFieldLabel}" />
                                    <TextBlock Text="{Binding MailTrafficOutgoingTotalText}"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               Foreground="#0069B4" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource ReputationCard}">
                                <StackPanel>
                                    <TextBlock Text="Eingehend · 24 Stunden"
                                               Style="{StaticResource ReputationFieldLabel}" />
                                    <TextBlock Text="{Binding MailTrafficIncomingTotalText}"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               Foreground="#16A34A" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Stündlicher Verlauf -->

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource ReputationCard}">
                                <StackPanel>
                                    <TextBlock Text="Ausgehende E-Mails"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding MailTrafficOutgoingPeakText}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               Margin="0,3,0,12" />

                                    <ItemsControl ItemsSource="{Binding MailTrafficOutgoingBars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="1,0">
                                                    <Grid Height="160">
                                                        <Border Height="{Binding BarHeight}"
                                                                VerticalAlignment="Bottom"
                                                                Background="#0069B4"
                                                                CornerRadius="2,2,0,0"
                                                                ToolTip="{Binding Tooltip}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding AxisLabel}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextAlignment="Center"
                                                               FontSize="9"
                                                               Margin="0,6,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="#E2E8F0"
                                            Height="1"
                                            Margin="0,4,0,0" />
                                    <TextBlock Text="E-Mails je Stunde · Uhrzeit lokal"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource ReputationCard}">
                                <StackPanel>
                                    <TextBlock Text="Eingehende E-Mails"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding MailTrafficIncomingPeakText}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               Margin="0,3,0,12" />

                                    <ItemsControl ItemsSource="{Binding MailTrafficIncomingBars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="1,0">
                                                    <Grid Height="160">
                                                        <Border Height="{Binding BarHeight}"
                                                                VerticalAlignment="Bottom"
                                                                Background="#16A34A"
                                                                CornerRadius="2,2,0,0"
                                                                ToolTip="{Binding Tooltip}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding AxisLabel}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextAlignment="Center"
                                                               FontSize="9"
                                                               Margin="0,6,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="#E2E8F0"
                                            Height="1"
                                            Margin="0,4,0,0" />
                                    <TextBlock Text="E-Mails je Stunde · Uhrzeit lokal"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Top 3 Accounts nach Volumen -->

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource ReputationCard}">
                                <StackPanel>
                                    <TextBlock Text="Top 3 · versendende Accounts"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding MailTrafficTopSenders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="75" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Rank}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#0069B4" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Account}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Account}"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CountText}"
                                                               TextAlignment="Right"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource ReputationCard}">
                                <StackPanel>
                                    <TextBlock Text="Top 3 · empfangende Accounts"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding MailTrafficTopRecipients}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="75" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Rank}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#16A34A" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Account}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Account}"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CountText}"
                                                               TextAlignment="Right"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding MailTrafficDataAgeText}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11" />

                        <TextBlock Text="Hinweis: Ein hohes Versandvolumen ist ein Indikator für eine mögliche Störung oder einen kompromittierten Account, kein automatischer Spamnachweis. Nachrichteninhalte werden nicht angezeigt."
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>


            <!-- Mail-Sicherheit: Plesk Outgoing Mail Control, nur lesend -->
            <TabItem Header="Mail-Sicherheit"
                     Padding="18,9">

                <Grid Margin="12,16,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Mail-Sicherheit"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />

                        <TextBlock Text="Plesk Outgoing Mail Control · Accountübersicht und Limitüberschreitungen"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            CornerRadius="8"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            Background="#EFF6FF"
                            Padding="12,10"
                            Margin="0,0,0,14">
                        <TextBlock Text="{Binding MailSecurityStatusText}"
                                   FontSize="13"
                                   Foreground="#1D4ED8"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ReputationCard}">
                            <StackPanel>
                                <TextBlock Text="Postfächer im Plesk-Bestand"
                                           Style="{StaticResource ReputationFieldLabel}" />
                                <TextBlock Text="{Binding MailSecurityMailboxCountText}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ReputationCard}">
                            <StackPanel>
                                <TextBlock Text="Mit aktuellen Plesk-Statistikzeilen"
                                           Style="{StaticResource ReputationFieldLabel}" />
                                <TextBlock Text="{Binding MailSecurityActiveCountText}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource ReputationCard}">
                            <StackPanel>
                                <TextBlock Text="Accounts mit Ablehnungen"
                                           Style="{StaticResource ReputationFieldLabel}" />
                                <TextBlock Text="{Binding MailSecurityRejectedCountText}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="#DC2626" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Sprint 43.3: optionale Risikoauswertung aus dem geschuetzten Server-API. -->
                    <!-- Im alten Server 0.1.3 bleibt dieser Abschnitt ohne Daten. -->
                    <Border Grid.Row="3"
                            Style="{StaticResource ReputationCard}"
                            Margin="0,0,0,12">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Risikoanalyse · Beobachtungsmodus"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding MailSecurityRiskStatusText}"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Vorläufige Indikatoren aus Plesk-Berichtszeilen – kein Spamnachweis, keine automatische Sperre."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                <DataGrid ItemsSource="{Binding MailSecurityRiskFindings}"
                                          MaxHeight="190"
                                          MinHeight="85"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STUFE"
                                                            Binding="{Binding SeverityText}"
                                                            Width="90" />
                                        <DataGridTextColumn Header="ACCOUNT"
                                                            Binding="{Binding Account}"
                                                            Width="2*" />
                                        <DataGridTextColumn Header="ABGEWIESEN"
                                                            Binding="{Binding RejectedText}"
                                                            Width="100" />
                                        <DataGridTextColumn Header="QUOTE"
                                                            Binding="{Binding RejectionShareText}"
                                                            Width="85" />
                                        <DataGridTextColumn Header="LIMIT"
                                                            Binding="{Binding LimitStatusText}"
                                                            Width="90" />
                                        <DataGridTextColumn Header="BEGRÜNDUNG"
                                                            Binding="{Binding Explanation}"
                                                            Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Grid Grid.Row="4" MinHeight="240">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource ReputationCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Accounts mit Plesk-Statistik"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />

                                <TextBlock Grid.Row="1"
                                           Text="Nach Ablehnungen absteigend · Zeile auswählen"
                                           FontSize="12"
                                           Margin="0,4,0,12"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding MailSecurityAccounts}"
                                          SelectedItem="{Binding SelectedMailSecurityAccount, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          SelectionMode="Single"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="POSTFACH"
                                                            Binding="{Binding Account}"
                                                            Width="2*" />

                                        <DataGridTextColumn Header="LIMIT"
                                                            Binding="{Binding LimitText}"
                                                            Width="*" />

                                        <DataGridTextColumn Header="ZUGELASSEN"
                                                            Binding="{Binding PassedText}"
                                                            Width="*" />

                                        <DataGridTextColumn Header="ABGEWIESEN"
                                                            Binding="{Binding RejectedText}"
                                                            Width="*" />

                                        <DataGridTextColumn Header="HINWEIS"
                                                            Binding="{Binding StatusText}"
                                                            Width="1.4*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource ReputationCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Account-Details"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,12,0,4"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedMailSecurityAccount.Account}" />

                                <TextBlock Grid.Row="2"
                                           Margin="0,0,0,4"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding SelectedMailSecurityAccount.StatusText}" />

                                <TextBlock Grid.Row="3"
                                           Margin="0,10,0,6"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="Plesk-Berichtszeilen (Quellzeit)" />

                                <DataGrid Grid.Row="4"
                                          ItemsSource="{Binding SelectedMailSecurityAccount.Periods}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ZEIT"
                                                            Binding="{Binding Time}"
                                                            Width="2*" />
                                        <DataGridTextColumn Header="OK"
                                                            Binding="{Binding PassedText}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="BLOCKIERT"
                                                            Binding="{Binding RejectedText}"
                                                            Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="5" Margin="0,12,0,0">
                        <TextBlock Text="{Binding MailSecurityDataAgeText}"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Nur Leseansicht. Die Plesk-Zahlen gelten ausschließlich für die gelieferten Berichtszeilen; sie sind weder eine vollständige 24-Stunden-Statistik noch ein Spamnachweis. Versandkontrolle und automatische Sperren sind noch deaktiviert." />
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

    </Grid>

</Window>
