<Window x:Class="Telenec.Mail.Statistics.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="820"
        MinWidth="1000"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#0069B4" />

        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#FFFFFF" />

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#1E293B" />

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B" />

        <SolidColorBrush x:Key="TodayBrush"
                         Color="#0069B4" />

        <SolidColorBrush x:Key="WeekBrush"
                         Color="#3B82F6" />

        <SolidColorBrush x:Key="MonthBrush"
                         Color="#94A3B8" />

        <SolidColorBrush x:Key="InactiveBrush"
                         Color="#F59E0B" />

        <Style x:Key="DashboardCard"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius"
                    Value="12" />
            <Setter Property="Padding"
                    Value="22" />
            <Setter Property="Margin"
                    Value="6" />
            <Setter Property="BorderBrush"
                    Value="#E2E8F0" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>

        <Style x:Key="MetricValue"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="34" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="MetricLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="TextAlignment"
                    Value="Center" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="Margin"
                    Value="0,8,0,0" />
        </Style>

        <Style x:Key="ChartProgressBar"
               TargetType="ProgressBar">
            <Setter Property="Height"
                    Value="14" />
            <Setter Property="Minimum"
                    Value="0" />
            <Setter Property="Maximum"
                    Value="100" />
            <Setter Property="Background"
                    Value="#E8EDF2" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="ChartLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="ChartValue"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="HorizontalAlignment"
                    Value="Right" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="StatusBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#EFF6FF" />
            <Setter Property="BorderBrush"
                    Value="#BFDBFE" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">
                    <Setter Property="Background"
                            Value="#F0FDF4" />
                    <Setter Property="BorderBrush"
                            Value="#BBF7D0" />
                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">
                    <Setter Property="Background"
                            Value="#FFF7ED" />
                    <Setter Property="BorderBrush"
                            Value="#FED7AA" />
                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">
                    <Setter Property="Background"
                            Value="#FEF2F2" />
                    <Setter Property="BorderBrush"
                            Value="#FECACA" />
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Foreground"
                    Value="#1D4ED8" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">
                    <Setter Property="Foreground"
                            Value="#166534" />
                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">
                    <Setter Property="Foreground"
                            Value="#9A3412" />
                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="#991B1B" />
                </DataTrigger>

            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="150" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="{Binding DashboardTitle}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />

                <TextBlock Text="{Binding DashboardSubtitle}"
                           Margin="0,6,0,0"
                           FontSize="15"
                           Foreground="{StaticResource SecondaryTextBrush}" />

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="Aktualisieren"
                        Command="{Binding RefreshCommand}"
                        Padding="16,8"
                        Margin="0,0,12,0"
                        FontSize="14"
                        Cursor="Hand" />

                <Border Background="{StaticResource PrimaryBrush}"
                        CornerRadius="8"
                        Padding="14,8">

                    <TextBlock Text="{Binding ApplicationVersionText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="15" />

                </Border>

            </StackPanel>

        </Grid>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource DashboardCard}">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="{Binding TotalInstallations}"
                               FontSize="44"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="Installationen insgesamt"
                               Style="{StaticResource MetricLabel}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />

                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource DashboardCard}">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="{Binding ActiveToday}"
                               Style="{StaticResource MetricValue}" />

                    <TextBlock Text="Heute aktiv"
                               Style="{StaticResource MetricLabel}" />

                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource DashboardCard}">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="{Binding ActiveLast7Days}"
                               Style="{StaticResource MetricValue}" />

                    <TextBlock Text="Letzte 7 Tage"
                               Style="{StaticResource MetricLabel}" />

                </StackPanel>

            </Border>

            <Border Grid.Column="3"
                    Style="{StaticResource DashboardCard}">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="{Binding ActiveLast30Days}"
                               Style="{StaticResource MetricValue}" />

                    <TextBlock Text="Letzte 30 Tage"
                               Style="{StaticResource MetricLabel}" />

                </StackPanel>

            </Border>

            <Border Grid.Column="4"
                    Style="{StaticResource DashboardCard}">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="{Binding InactiveOver30Days}"
                               Style="{StaticResource MetricValue}" />

                    <TextBlock Text="Über 30 Tage inaktiv"
                               Style="{StaticResource MetricLabel}" />

                </StackPanel>

            </Border>

        </Grid>

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource DashboardCard}"
                    Margin="0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Aktivität nach Zeitraum"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />

                    <TextBlock Grid.Row="2"
                               Text="Kumulative Reichweite bezogen auf alle Installationen"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <Grid Grid.Row="4">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Heute"
                                       Style="{StaticResource ChartLabel}" />

                            <ProgressBar Grid.Column="1"
                                         Value="{Binding ActiveTodayPercentage, Mode=OneWay}"
                                         Foreground="{StaticResource TodayBrush}"
                                         Style="{StaticResource ChartProgressBar}"
                                         Margin="10,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ActiveTodayChartText}"
                                       Style="{StaticResource ChartValue}" />

                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Letzte 7 Tage"
                                       Style="{StaticResource ChartLabel}" />

                            <ProgressBar Grid.Column="1"
                                         Value="{Binding ActiveLast7DaysPercentage, Mode=OneWay}"
                                         Foreground="{StaticResource WeekBrush}"
                                         Style="{StaticResource ChartProgressBar}"
                                         Margin="10,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ActiveLast7DaysChartText}"
                                       Style="{StaticResource ChartValue}" />

                        </Grid>

                        <Grid Grid.Row="2"
                              Margin="0,4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Letzte 30 Tage"
                                       Style="{StaticResource ChartLabel}" />

                            <ProgressBar Grid.Column="1"
                                         Value="{Binding ActiveLast30DaysPercentage, Mode=OneWay}"
                                         Foreground="{StaticResource MonthBrush}"
                                         Style="{StaticResource ChartProgressBar}"
                                         Margin="10,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ActiveLast30DaysChartText}"
                                       Style="{StaticResource ChartValue}" />

                        </Grid>

                        <Grid Grid.Row="3"
                              Margin="0,4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Über 30 Tage"
                                       Style="{StaticResource ChartLabel}" />

                            <ProgressBar Grid.Column="1"
                                         Value="{Binding InactiveOver30DaysPercentage, Mode=OneWay}"
                                         Foreground="{StaticResource InactiveBrush}"
                                         Style="{StaticResource ChartProgressBar}"
                                         Margin="10,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding InactiveOver30DaysChartText}"
                                       Style="{StaticResource ChartValue}" />

                        </Grid>

                    </Grid>

                </Grid>

            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource DashboardCard}"
                    Margin="0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Verteilung nach letztem Kontakt"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />

                    <TextBlock Grid.Row="2"
                               Text="Jede Installation erscheint genau in einer Gruppe"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <Grid Grid.Row="4">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Heute"
                                       Style="{StaticResource ChartLabel}" />

                            <ProgressBar Grid.Column="1"
                                         Value="{Binding ActiveTodayPercentage, Mode=OneWay}"
                                         Foreground="{StaticResource TodayBrush}"
                                         Style="{StaticResource ChartProgressBar}"
                                         Margin="10,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ActiveTodayChartText}"
                                       Style="{StaticResource ChartValue}" />

                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Vor 1–7 Tagen"
                                       Style="{StaticResource ChartLabel}" />

                            <ProgressBar Grid.Column="1"
                                         Value="{Binding ActiveDays1To7Percentage, Mode=OneWay}"
                                         Foreground="{StaticResource WeekBrush}"
                                         Style="{StaticResource ChartProgressBar}"
                                         Margin="10,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ActiveDays1To7ChartText}"
                                       Style="{StaticResource ChartValue}" />

                        </Grid>

                        <Grid Grid.Row="2"
                              Margin="0,4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Vor 8–30 Tagen"
                                       Style="{StaticResource ChartLabel}" />

                            <ProgressBar Grid.Column="1"
                                         Value="{Binding ActiveDays8To30Percentage, Mode=OneWay}"
                                         Foreground="{StaticResource MonthBrush}"
                                         Style="{StaticResource ChartProgressBar}"
                                         Margin="10,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ActiveDays8To30ChartText}"
                                       Style="{StaticResource ChartValue}" />

                        </Grid>

                        <Grid Grid.Row="3"
                              Margin="0,4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Über 30 Tage"
                                       Style="{StaticResource ChartLabel}" />

                            <ProgressBar Grid.Column="1"
                                         Value="{Binding InactiveOver30DaysPercentage, Mode=OneWay}"
                                         Foreground="{StaticResource InactiveBrush}"
                                         Style="{StaticResource ChartProgressBar}"
                                         Margin="10,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding InactiveOver30DaysChartText}"
                                       Style="{StaticResource ChartValue}" />

                        </Grid>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

        <Border Grid.Row="6"
                Style="{StaticResource StatusBorderStyle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">

            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource StatusTextStyle}" />

        </Border>

    </Grid>

</Window>