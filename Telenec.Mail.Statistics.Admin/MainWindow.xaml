<Window x:Class="Telenec.Mail.Statistics.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/TelenecMailAdmin.ico"
        Width="1180"
        Height="820"
        MinWidth="1000"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>

        <!-- Gemeinsame Farben -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#0069B4" />

        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#FFFFFF" />

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#1E293B" />

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B" />

        <SolidColorBrush x:Key="TodayBrush"
                         Color="#0069B4" />

        <SolidColorBrush x:Key="WeekBrush"
                         Color="#3B82F6" />

        <SolidColorBrush x:Key="MonthBrush"
                         Color="#94A3B8" />

        <SolidColorBrush x:Key="InactiveBrush"
                         Color="#F59E0B" />

        <!-- Statistik-Karten -->

        <Style x:Key="DashboardCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}" />

            <Setter Property="CornerRadius"
                    Value="12" />

            <Setter Property="Padding"
                    Value="22" />

            <Setter Property="Margin"
                    Value="6" />

            <Setter Property="BorderBrush"
                    Value="#E2E8F0" />

            <Setter Property="BorderThickness"
                    Value="1" />

        </Style>

        <Style x:Key="MetricValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="34" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="HorizontalAlignment"
                    Value="Center" />

        </Style>

        <Style x:Key="MetricLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />

            <Setter Property="HorizontalAlignment"
                    Value="Center" />

            <Setter Property="TextAlignment"
                    Value="Center" />

            <Setter Property="TextWrapping"
                    Value="Wrap" />

            <Setter Property="Margin"
                    Value="0,8,0,0" />

        </Style>

        <!-- Statistik-Diagramme -->

        <Style x:Key="ChartProgressBar"
               TargetType="ProgressBar">

            <Setter Property="Height"
                    Value="14" />

            <Setter Property="Minimum"
                    Value="0" />

            <Setter Property="Maximum"
                    Value="100" />

            <Setter Property="Background"
                    Value="#E8EDF2" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <Style x:Key="ChartLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <Style x:Key="ChartValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />

            <Setter Property="HorizontalAlignment"
                    Value="Right" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <!-- Statistik-Status -->

        <Style x:Key="StatusBorderStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#EFF6FF" />

            <Setter Property="BorderBrush"
                    Value="#BFDBFE" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">

                    <Setter Property="Background"
                            Value="#F0FDF4" />

                    <Setter Property="BorderBrush"
                            Value="#BBF7D0" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">

                    <Setter Property="Background"
                            Value="#FFF7ED" />

                    <Setter Property="BorderBrush"
                            Value="#FED7AA" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">

                    <Setter Property="Background"
                            Value="#FEF2F2" />

                    <Setter Property="BorderBrush"
                            Value="#FECACA" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="StatusTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="#1D4ED8" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">

                    <Setter Property="Foreground"
                            Value="#166534" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">

                    <Setter Property="Foreground"
                            Value="#9A3412" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">

                    <Setter Property="Foreground"
                            Value="#991B1B" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- Reputations-Karten -->

        <Style x:Key="ReputationCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="Padding"
                    Value="15" />

            <Setter Property="BorderBrush"
                    Value="#E2E8F0" />

            <Setter Property="BorderThickness"
                    Value="1" />

        </Style>

        <Style x:Key="ReputationFieldLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />

            <Setter Property="Margin"
                    Value="0,0,0,5" />

        </Style>

        <Style x:Key="ReputationFieldValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="16" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="TextWrapping"
                    Value="Wrap" />

        </Style>

        <!-- Kompakte Blacklist-Statussymbole -->

        <Style x:Key="BlacklistStatusSymbol"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="19" />

            <Setter Property="FontWeight"
                    Value="Bold" />

            <Setter Property="Foreground"
                    Value="#64748B" />

            <Setter Property="Width"
                    Value="26" />

            <Setter Property="TextAlignment"
                    Value="Center" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">

                    <Setter Property="Foreground"
                            Value="#16A34A" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">

                    <Setter Property="Foreground"
                            Value="#DC2626" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">

                    <Setter Property="Foreground"
                            Value="#D97706" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Neutral">

                    <Setter Property="Foreground"
                            Value="#94A3B8" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="BlacklistStatusLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="Foreground"
                    Value="#64748B" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">

                    <Setter Property="Foreground"
                            Value="#166534" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">

                    <Setter Property="Foreground"
                            Value="#991B1B" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">

                    <Setter Property="Foreground"
                            Value="#9A3412" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <!-- Fensteraufbau -->

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="pack://application:,,,/Assets/TelenecMailAdminPanelLogo.png"
                   Height="82"
                   MaxWidth="470"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Stretch="Uniform" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="Aktualisieren"
                        Command="{Binding RefreshCommand}"
                        Padding="16,8"
                        Margin="0,0,12,0"
                        FontSize="14"
                        Cursor="Hand" />

                <Border Background="{StaticResource PrimaryBrush}"
                        CornerRadius="8"
                        Padding="14,8">

                    <TextBlock Text="{Binding ApplicationVersionText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="15" />

                </Border>

            </StackPanel>

        </Grid>

        <!-- Registerkarten -->

        <TabControl Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="#E2E8F0"
                    FontSize="14">

            <!-- Nutzungsstatistik -->

            <TabItem Header="Nutzungsstatistik"
                     Padding="18,9">

                <Grid Margin="12,16,12,12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Kennzahlen -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource DashboardCard}">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding TotalInstallations}"
                                           FontSize="44"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" />

                                <TextBlock Text="Installationen insgesamt"
                                           Style="{StaticResource MetricLabel}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource DashboardCard}">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding ActiveToday}"
                                           Style="{StaticResource MetricValue}" />

                                <TextBlock Text="Heute aktiv"
                                           Style="{StaticResource MetricLabel}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource DashboardCard}">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding ActiveLast7Days}"
                                           Style="{StaticResource MetricValue}" />

                                <TextBlock Text="Letzte 7 Tage"
                                           Style="{StaticResource MetricLabel}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="3"
                                Style="{StaticResource DashboardCard}">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding ActiveLast30Days}"
                                           Style="{StaticResource MetricValue}" />

                                <TextBlock Text="Letzte 30 Tage"
                                           Style="{StaticResource MetricLabel}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource DashboardCard}">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding InactiveOver30Days}"
                                           Style="{StaticResource MetricValue}" />

                                <TextBlock Text="Über 30 Tage inaktiv"
                                           Style="{StaticResource MetricLabel}" />

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- Beide bestehenden Statistikdiagramme -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Diagramm: Aktivität nach Zeitraum -->

                        <Border Grid.Column="0"
                                Style="{StaticResource DashboardCard}"
                                Margin="0">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Aktivität nach Zeitraum"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />

                                <TextBlock Grid.Row="2"
                                           Text="Kumulative Reichweite bezogen auf alle Installationen"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                <Grid Grid.Row="4">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Heute"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveTodayPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource TodayBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveTodayChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Letzte 7 Tage"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveLast7DaysPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource WeekBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveLast7DaysChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Letzte 30 Tage"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveLast30DaysPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource MonthBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveLast30DaysChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="3"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Über 30 Tage"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding InactiveOver30DaysPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource InactiveBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding InactiveOver30DaysChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                        <!-- Diagramm: Verteilung nach letztem Kontakt -->

                        <Border Grid.Column="2"
                                Style="{StaticResource DashboardCard}"
                                Margin="0">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Verteilung nach letztem Kontakt"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />

                                <TextBlock Grid.Row="2"
                                           Text="Jede Installation erscheint genau in einer Gruppe"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                <Grid Grid.Row="4">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Heute"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveTodayPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource TodayBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveTodayChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Vor 1–7 Tagen"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveDays1To7Percentage, Mode=OneWay}"
                                                     Foreground="{StaticResource WeekBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveDays1To7ChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Vor 8–30 Tagen"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ActiveDays8To30Percentage, Mode=OneWay}"
                                                     Foreground="{StaticResource MonthBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActiveDays8To30ChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                    <Grid Grid.Row="3"
                                          Margin="0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Über 30 Tage"
                                                   Style="{StaticResource ChartLabel}" />

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding InactiveOver30DaysPercentage, Mode=OneWay}"
                                                     Foreground="{StaticResource InactiveBrush}"
                                                     Style="{StaticResource ChartProgressBar}"
                                                     Margin="10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding InactiveOver30DaysChartText}"
                                                   Style="{StaticResource ChartValue}" />

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                    </Grid>

                    <!-- Statistik-Statuszeile -->

                    <Border Grid.Row="4"
                            Style="{StaticResource StatusBorderStyle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8">

                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource StatusTextStyle}" />

                    </Border>

                </Grid>

            </TabItem>

            <!-- Mailserver-Reputation -->

            <TabItem Header="Mailserver-Reputation"
                     Padding="18,9">

                <Grid Margin="18,18,18,16">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Überschrift, manueller Start und Prüfumfang -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="{Binding ReputationTitle}"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />

                            <TextBlock Text="Übersicht der überwachten Blacklist-Anbieter"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,4,0,0" />

                        </StackPanel>

                        <!-- Manueller Blacklist-Check.
                             Der AsyncRelayCommand verhindert
                             während der Ausführung weitere Klicks. -->

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button Command="{Binding CheckReputationCommand}"
                                    Padding="16,9"
                                    Margin="0,0,12,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Background="#0069B4"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand">

                                <Button.Style>

                                    <Style TargetType="Button">

                                        <Setter Property="Content"
                                                Value="Jetzt prüfen" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsReputationChecking}"
                                                         Value="True">

                                                <Setter Property="Content"
                                                        Value="Prüfung läuft …" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Button.Style>

                            </Button>

                            <Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    VerticalAlignment="Center">

                                <TextBlock Text="{Binding ReputationScopeText}"
                                           FontSize="12"
                                           Foreground="#1D4ED8"
                                           FontWeight="SemiBold" />

                            </Border>

                        </StackPanel>

                    </Grid>

                    <!-- Mailserver-Informationen -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource ReputationCard}">

                            <StackPanel>

                                <TextBlock Text="Mailserver"
                                           Style="{StaticResource ReputationFieldLabel}" />

                                <TextBlock Text="{Binding ReputationHostname}"
                                           Style="{StaticResource ReputationFieldValue}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource ReputationCard}">

                            <StackPanel>

                                <TextBlock Text="Versand-IP"
                                           Style="{StaticResource ReputationFieldLabel}" />

                                <TextBlock Text="{Binding ReputationIpAddress}"
                                           Style="{StaticResource ReputationFieldValue}" />

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource ReputationCard}">

                            <StackPanel>

                                <TextBlock Text="Letzte erfolgreiche PSBL-Prüfung"
                                           Style="{StaticResource ReputationFieldLabel}" />

                                <TextBlock Text="{Binding ReputationLastSuccessfulCheckText}"
                                           Style="{StaticResource ReputationFieldValue}" />

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- Zusammenfassung -->

                    <Border Grid.Row="4"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">

                        <StackPanel>

                            <TextBlock Text="{Binding ReputationSummaryText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding ReputationStatusText}"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding ReputationDetailText}"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       MaxHeight="32" />

                            <!-- Rückmeldung zum manuellen Prüfvorgang -->

                            <TextBlock Text="{Binding ReputationCheckMessage}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#1D4ED8"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                    <!-- Dynamische Blacklist-Liste -->

                    <DataGrid Grid.Row="6"
                              ItemsSource="{Binding ReputationEntries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              VerticalGridLinesBrush="Transparent"
                              RowHeight="34"
                              ColumnHeaderHeight="34"
                              Background="White"
                              BorderBrush="#E2E8F0"
                              BorderThickness="1"
                              FontSize="13"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="White"
                              EnableRowVirtualization="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <!-- Technische Details bei Mausberührung -->

                        <DataGrid.RowStyle>

                            <Style TargetType="{x:Type DataGridRow}">

                                <Setter Property="ToolTip"
                                        Value="{Binding DetailsText}" />

                                <Setter Property="MinHeight"
                                        Value="34" />

                            </Style>

                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <!-- Name der Blacklist -->

                            <DataGridTextColumn Header="BLACKLIST"
                                                Binding="{Binding DisplayName}"
                                                Width="*">

                                <DataGridTextColumn.ElementStyle>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="VerticalAlignment"
                                                Value="Center" />

                                        <Setter Property="Foreground"
                                                Value="#1E293B" />

                                        <Setter Property="FontWeight"
                                                Value="Medium" />

                                        <Setter Property="Margin"
                                                Value="12,0,0,0" />

                                        <Setter Property="TextTrimming"
                                                Value="CharacterEllipsis" />

                                    </Style>

                                </DataGridTextColumn.ElementStyle>

                            </DataGridTextColumn>

                            <!-- Statussymbol und Statusbezeichnung -->

                            <DataGridTemplateColumn Header="STATUS"
                                                    Width="195"
                                                    CanUserSort="False">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid Margin="8,0,12,0">

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding DetailsText}">

                                                <TextBlock Text="{Binding StatusSymbol}"
                                                           Style="{StaticResource BlacklistStatusSymbol}" />

                                                <TextBlock Text="{Binding StatusText}"
                                                           Style="{StaticResource BlacklistStatusLabel}"
                                                           Margin="6,0,0,0" />

                                            </StackPanel>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- Statuslegende und letzter Abruf -->

                    <Grid Grid.Row="8">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0">

                            <TextBlock Text="✔  Nicht gelistet"
                                       Foreground="#166534"
                                       FontSize="12"
                                       Margin="0,0,20,0" />

                            <TextBlock Text="✖  Gelistet"
                                       Foreground="#991B1B"
                                       FontSize="12"
                                       Margin="0,0,20,0" />

                            <TextBlock Text="⚠  Prüfung fehlgeschlagen"
                                       Foreground="#9A3412"
                                       FontSize="12"
                                       Margin="0,0,20,0" />

                            <TextBlock Text="—  Nicht integriert / ungeprüft"
                                       Foreground="#64748B"
                                       FontSize="12" />

                        </WrapPanel>

                        <StackPanel Grid.Row="2">

                            <TextBlock FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap">

                                <Run Text="Letzter Prüfversuch: " />

                                <Run Text="{Binding ReputationLastAttemptText}" />

                                <Run Text=" · DNS-Auflösung: " />

                                <Run Text="{Binding ReputationResolvedAddresses}" />

                            </TextBlock>

                            <TextBlock Text="Die angezeigten Ergebnisse gelten nur für tatsächlich geprüfte Listen. Nicht integrierte Anbieter sind keine negativen Prüfergebnisse."
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />

                        </StackPanel>

                    </Grid>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</Window>
