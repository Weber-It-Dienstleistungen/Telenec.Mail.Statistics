<Window x:Class="Telenec.Mail.Statistics.Admin.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#0069B4" />

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#1E293B" />

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B" />

        <Style x:Key="StatusBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#EFF6FF" />
            <Setter Property="BorderBrush"
                    Value="#BFDBFE" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">
                    <Setter Property="Background"
                            Value="#F0FDF4" />
                    <Setter Property="BorderBrush"
                            Value="#BBF7D0" />
                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">
                    <Setter Property="Background"
                            Value="#FFF7ED" />
                    <Setter Property="BorderBrush"
                            Value="#FED7AA" />
                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">
                    <Setter Property="Background"
                            Value="#FEF2F2" />
                    <Setter Property="BorderBrush"
                            Value="#FECACA" />
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#1D4ED8" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Success">
                    <Setter Property="Foreground"
                            Value="#166534" />
                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Warning">
                    <Setter Property="Foreground"
                            Value="#9A3412" />
                </DataTrigger>

                <DataTrigger Binding="{Binding StatusKind}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="#991B1B" />
                </DataTrigger>

            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="36">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Telenec Mail Statistik"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />

            <TextBlock Text="Ersteinrichtung"
                       Margin="0,5,0,0"
                       FontSize="17"
                       Foreground="{StaticResource PrimaryBrush}" />

            <TextBlock Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Bitte die Adresse des Statistikservers und den Admin-API-Schlüssel eingeben. Die Verbindung wird geprüft, bevor die Einstellungen gespeichert werden." />

        </StackPanel>

        <StackPanel Grid.Row="2">

            <TextBlock Text="Serveradresse"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,7" />

            <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                     Height="38"
                     Padding="10,7"
                     FontSize="14"
                     VerticalContentAlignment="Center" />

            <TextBlock Text="Produktiv ausschließlich HTTPS; HTTP ist nur für localhost in der Entwicklung erlaubt."
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" />

        </StackPanel>

        <StackPanel Grid.Row="4">

            <TextBlock Text="Admin-API-Schlüssel"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,7" />

            <PasswordBox x:Name="AdminApiKeyPasswordBox"
                         Height="38"
                         Padding="10,7"
                         FontSize="14"
                         VerticalContentAlignment="Center" />

            <TextBlock Text="Der Schlüssel wird nach erfolgreicher Prüfung im Windows Credential Manager gespeichert."
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" />

        </StackPanel>

        <Border Grid.Row="6"
                Style="{StaticResource StatusBorderStyle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,9">

            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource StatusTextStyle}"
                       FontSize="13"
                       TextWrapping="Wrap" />

        </Border>

        <Grid Grid.Row="8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Abbrechen"
                    Width="100"
                    Height="36"
                    Click="OnCancelClick"
                    IsEnabled="{Binding CanSubmit}"
                    IsCancel="True"
                    Cursor="Hand" />

            <Button Grid.Column="3"
                    Content="Verbindung prüfen"
                    Width="150"
                    Height="36"
                    Click="OnSetupClick"
                    IsEnabled="{Binding CanSubmit}"
                    IsDefault="True"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Cursor="Hand" />

        </Grid>

    </Grid>

</Window>