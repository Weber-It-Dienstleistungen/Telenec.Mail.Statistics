{
  "Statistics": {
    "DatabasePath": "Storage/telenec-mail-statistics.db",
    "RetentionDays": 365
  },
  "MailSecurity": {
    "EnableHistoryWorker": false,
    "AllowHistorySchemaMigration": false
  },
  "Reputation": {
    "EnableExtendedDnsbl": true,
    "EnableReviewDnsbl": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
